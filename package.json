{
  "name": "videogen",
  "version": "2.1.3",
  "private": true,
  "description": "Local AI video batch studio with per-shot frames, CSV imports, gallery selection and crash recovery.",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/swf-cmd/videogen.git"
  },
  "homepage": "https://github.com/swf-cmd/videogen#readme",
  "bugs": {
    "url": "https://github.com/swf-cmd/videogen/issues"
  },
  "keywords": [
    "video-generation",
    "ai-video",
    "render-queue",
    "nodejs",
    "local-first",
    "openrouter"
  ],
  "scripts": {
    "start": "node scripts/check-runtime.cjs && node --no-use-env-proxy server.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test acceptance/crash-queue.cjs",
    "package:portable": "python3 scripts/package-portable.py",
    "test:portable": "node --test test/portable-launcher.test.js",
    "recover:data": "node scripts/recover-data.cjs"
  },
  "engines": {
    "node": "^22.21.0 || >=24.5.0"
  }
}
